<diagram id="titipcuci-7" name="07 - Business Process Flow"><mxGraphModel dx="1450" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1840" pageHeight="1940" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n1" value="&lt;b&gt;BUSINESS PROCESS FLOW - END TO END&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:12px&quot;&gt;WBS 1.7, 2.3, 2.7 | Model proses target sesuai blueprint TitipCuci, termasuk tahapan M8–M9&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f6fa;strokeColor=#c6d1df;fontColor=#1c2e46;fontSize=13;align=center;verticalAlign=middle;spacing=8;fontSize=20;align=left;spacingLeft=20;" vertex="1" parent="1"><mxGeometry x="50" y="25" width="1740" height="76" as="geometry"/></mxCell><mxCell id="n2" value="1. CUSTOMER - Login / Register" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f1fc;strokeColor=#6988b2;fontColor=#1c2e46;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="90" y="175" width="385" height="100" as="geometry"/></mxCell><mxCell id="n3" value="2. Pilih Layanan, Alamat, Slot" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f1fc;strokeColor=#6988b2;fontColor=#1c2e46;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="90" y="355" width="385" height="100" as="geometry"/></mxCell><mxCell id="n4" value="3. Create Order + Estimate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f1fc;strokeColor=#6988b2;fontColor=#1c2e46;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="90" y="535" width="385" height="100" as="geometry"/></mxCell><mxCell id="n5" value="4. ADMIN - Confirm / Reject" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#efebff;strokeColor=#8170b0;fontColor=#1c2e46;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="90" y="715" wid